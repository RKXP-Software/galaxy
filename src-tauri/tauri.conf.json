{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galaxy",
  "version": "0.1.1",
  "identifier": "com.galaxy.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Galaxy",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
        "frame-src": "'self' blob: data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Pedro Sarmento",
    "shortDescription": "Visualizador universal de arquivos",
    "longDescription": "Abra textos, markdown, JSON, imagens, áudio, vídeo, PDF, planilhas, documentos do Office, zip e e-books em um único app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "log",
          "ini",
          "cfg",
          "conf",
          "srt",
          "vtt",
          "nfo"
        ],
        "name": "Galaxy Texto",
        "description": "Arquivo de texto",
        "role": "Viewer"
      },
      {
        "ext": [
          "md",
          "markdown",
          "mkd"
        ],
        "name": "Galaxy Markdown",
        "description": "Documento Markdown",
        "role": "Viewer"
      },
      {
        "ext": [
          "json",
          "jsonc",
          "jsonl",
          "geojson"
        ],
        "name": "Galaxy JSON",
        "description": "Arquivo JSON",
        "role": "Viewer"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "svg",
          "bmp",
          "ico",
          "avif"
        ],
        "name": "Galaxy Imagem",
        "description": "Imagem",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3",
          "wav",
          "ogg",
          "flac",
          "m4a",
          "aac",
          "opus"
        ],
        "name": "Galaxy Áudio",
        "description": "Arquivo de áudio",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp4",
          "m4v",
          "webm",
          "mov",
          "ogv"
        ],
        "name": "Galaxy Vídeo",
        "description": "Arquivo de vídeo",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "Galaxy PDF",
        "description": "Documento PDF",
        "role": "Viewer"
      },
      {
        "ext": [
          "csv",
          "tsv",
          "xls",
          "xlsx",
          "xlsm",
          "xlsb",
          "ods"
        ],
        "name": "Galaxy Planilha",
        "description": "Planilha",
        "role": "Viewer"
      },
      {
        "ext": [
          "doc",
          "docx",
          "rtf",
          "odt"
        ],
        "name": "Galaxy Documento",
        "description": "Documento",
        "role": "Viewer"
      },
      {
        "ext": [
          "pptx",
          "ppsx"
        ],
        "name": "Galaxy Apresentação",
        "description": "Apresentação",
        "role": "Viewer"
      },
      {
        "ext": [
          "zip"
        ],
        "name": "Galaxy Compactado",
        "description": "Arquivo compactado",
        "role": "Viewer"
      },
      {
        "ext": [
          "epub"
        ],
        "name": "Galaxy E-book",
        "description": "E-book",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
